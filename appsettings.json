{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // JWT Configuration
  // In production: move SecretKey to Azure Key Vault, never keep in code
  "Jwt": {
    "SecretKey": "ThisIsAVeryLongSecretKeyForJwtDemoMinimum32Characters!",
    "Issuer": "https://jwtauthdemo.com",
    "Audience": "https://jwtauthdemo.com"
  },

  // Database Connection
  // Update Server name if needed (. = local default SQL Server instance)
  "ConnectionStrings": {
    "Default": "Server=.;Database=JwtAuthDemo;Trusted_Connection=true;TrustServerCertificate=true;"
  }
}
